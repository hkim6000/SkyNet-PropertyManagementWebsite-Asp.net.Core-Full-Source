        },
        {
          "id": "bjwgnbz9v8",
          "type": "faq",
          "source": "",
          "hidden": false,
          "kicker": "",
          "title": "Applications",
          "text": "",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
          "items": [
            {
              "icon": "",
              "media": "",
              "title": "Who must apply",
              "text": "Everyone aged 18 or over who will live in the home fills in the application and is named on the lease.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Screening",
              "text": "We check identity, income, rental history and references, and run a credit and background check with your consent. We follow fair housing law and treat every applicant the same way.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Income",
              "text": "We look for a household income of about three times the monthly rent. A guarantor can make up the difference.",
              "link": "",
              "label": ""
            }
          ]
        },
        {
          "id": "bsv23pq4dr",
          "type": "faq",
          "source": "",
          "hidden": false,
          "kicker": "",
          "title": "Leases and rent",
          "text": "",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
          "items": [
            {
              "icon": "",
              "media": "",
              "title": "Rent",
              "text": "Rent is due on the 1st of each month. A $75 late fee is added if rent is still owed after the 5th.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Deposit",
              "text": "The security deposit equals one month of rent unless the listing says otherwise. It is held safely and returned with an itemized statement after you move out.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Renewals",
              "text": "We offer a renewal 90 days before your lease ends. If you plan to move, give 60 days written notice.",
              "link": "",
              "label": ""
            }
          ]
        },
        {
          "id": "brd4wtgdwr",
