          "kicker": "Policies",
          "title": "Our policies, in plain words",
          "text": "<p>These are the rules every application and lease follows. If something is unclear, ask us before you apply.</p>",
          "media": "",
          "label": "",
          "link": "",
          "label2": "",
          "link2": "",
          "flip": false,
