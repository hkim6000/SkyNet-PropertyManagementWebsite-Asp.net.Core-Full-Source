              "icon": "",
              "media": "",
              "title": "Pets",
              "text": "Each listing says which pets are allowed. A pet deposit applies.",
              "link": "",
              "label": ""
            },
            {
              "icon": "",
              "media": "",
              "title": "Smoking",
              "text": "All our homes are non-smoking, inside and on balconies.",
              "link": "",
              "label": ""
            },
